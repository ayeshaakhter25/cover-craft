MONGO_URI=your_mongodb_connection_string
JWT_SECRET=use_a_long_random_secret
SERPAPI_KEY=your_serpapi_key
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
# Development default is 60000 (one minute). Set 900000 for 15 minutes.
JOB_SYNC_INTERVAL_MS=60000
# Email sender (SMTP). Gmail uses smtp.gmail.com, port 587, and an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-email-app-password
EMAIL_FROM="Career Craft Alerts <your-sender@gmail.com>"
# Optional: enables direct YouTube video search results. Without it the app
# provides a YouTube search link plus all other resource categories.
YOUTUBE_API_KEY=your_youtube_data_api_key
# Optional: raises GitHub API rate limits for project searches.
GITHUB_TOKEN=your_github_personal_access_token
